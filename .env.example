# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Required to enable the 'apify' source in config.yaml.
# Also used by the 'naukri' source when set (it runs a Naukri actor on Apify).
# Get your token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Optional: override the Apify actor used by the 'naukri' source.
# Defaults to "scraper-engine~naukri-job-scraper". Only matters if APIFY_TOKEN
# is set. Without a token, naukri falls back to a best-effort direct fetch.
NAUKRI_APIFY_ACTOR=

# Required when llm_provider is "gemini" (the default).
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
